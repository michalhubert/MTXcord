+import { clearApprovedViewers, clearPendingRequests } from '@/lib/accessRequests'
+import { NextRequest } from 'next/server'
+
+// Lets the streamer start over from the dock: drops every approval and pending
+// request for a path, so everyone has to ask again.
+export async function POST(req: NextRequest) {
+  const path = req.nextUrl.searchParams.get('path') || 'default'
+  clearApprovedViewers(path)
+  clearPendingRequests(path)
+  return Response.json({ ok: true, path })
+}
