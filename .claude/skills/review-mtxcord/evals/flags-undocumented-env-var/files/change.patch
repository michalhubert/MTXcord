+describe('reroll cooldown setting read at import', () => {
+  afterEach(() => vi.resetModules())
+
+  async function cooldownWith(value?: string): Promise<number> {
+    vi.resetModules()
+    if (value !== undefined) vi.stubEnv('GUEST_REROLL_COOLDOWN_SECONDS', value)
+    return (await import('@/lib/guestIdentity')).GUEST_REROLL_COOLDOWN_MS
+  }
+
+  it('defaults to 30 seconds', async () => {
+    expect(await cooldownWith()).toBe(30_000)
+  })
+
+  it.each([
+    ['90', 90_000],
+    [' 5 ', 5_000],
+    ['1.5', 1_500],
+    ['0', 0],
+  ])('reads %j seconds', async (value, expected) => {
+    expect(await cooldownWith(value)).toBe(expected)
+  })
+
+  it.each(['', '   ', 'abc', '10s', '-5', 'Infinity'])(
+    'falls back to 30 seconds for %j',
+    async (value) => {
+      expect(await cooldownWith(value)).toBe(30_000)
+    },
+  )
+
+  it('is what the claim uses', async () => {
+    useFakeClock()
+    vi.resetModules()
+    vi.stubEnv('GUEST_REROLL_COOLDOWN_SECONDS', '10')
+    const mod = await import('@/lib/guestIdentity')
+    expect(mod.claimGuestReroll('live', IP)).toBe(0)
+    vi.advanceTimersByTime(4_000)
+    expect(mod.claimGuestReroll('live', IP)).toBe(6_000)
+  })
+})
+
