+// Starts the cooldown if it's over, and returns 0; otherwise the remaining ms.
+export function claimKeepToggle(path: string, key: string): number {
+  const id = identityKey(path, key)
+  const now = Date.now()
+  const at = keepToggledAt.get(id)
+  if (at !== undefined && now - at < KEEP_TOGGLE_COOLDOWN_MS) {
+    return at + KEEP_TOGGLE_COOLDOWN_MS - now
+  }
+  keepToggledAt.set(id, now)
+  return 0
+}
