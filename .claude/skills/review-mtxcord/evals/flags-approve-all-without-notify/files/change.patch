+import { describe, expect, it } from 'vitest'
+import { POST as approveAllPost } from '@/app/api/streams/pending/approve-all/route'
+import {
+  isApproved,
+  listPendingRequests,
+  openAccessRequest,
+  type AccessRequester,
+} from '@/lib/accessRequests'
+import { nextRequest } from '../helpers/request'
+import { asDiscord, asGuest, asStreamer, signedOut } from '../helpers/session'
+import { GUEST_IP, OTHER_IP } from './_support'
+
+const approveAll = (body: unknown) =>
+  approveAllPost(nextRequest('/api/streams/pending/approve-all', { json: body }))
+
+const guestRequest = (ip = GUEST_IP, path = 'cam'): AccessRequester => ({
+  path,
+  ip,
+  role: 'viewer',
+  name: null,
+  image: null,
+  discordId: null,
+  clientIp: ip,
+})
+const discordRequest = (id = '42', path = 'cam'): AccessRequester => ({
+  path,
+  ip: `discord:${id}`,
+  role: 'discord',
+  name: 'Luna',
+  image: null,
+  discordId: id,
+  clientIp: GUEST_IP,
+})
+
+describe('POST /api/streams/pending/approve-all', () => {
+  it.each([
+    ['signed out', () => signedOut()],
+    ['a guest', () => asGuest('pw')],
+    ['a Discord viewer', () => asDiscord('42', 'Luna')],
+  ])('401 for %s, and nothing changes', async (_label, signIn) => {
+    signIn()
+    openAccessRequest(guestRequest())
+
+    const res = await approveAll({ path: 'cam' })
+
+    expect(res.status).toBe(401)
+    expect(listPendingRequests()).toHaveLength(1)
+    expect(isApproved('cam', GUEST_IP, 'viewer')).toBe(false)
+  })
+
+  it('400 "Invalid JSON body" when the body is not JSON', async () => {
+    asStreamer()
+    const res = await approveAllPost(
+      nextRequest('/api/streams/pending/approve-all', {
+        method: 'POST',
+        body: 'nope',
+      }),
+    )
+    expect(res.status).toBe(400)
+    expect(await res.json()).toEqual({ error: 'Invalid JSON body' })
+  })
+
+  it.each([
+    ['an empty object', {}],
+    ['a null body', null],
+    ['an empty path', { path: '' }],
+    ['a non-string path', { path: 5 }],
+    ['a path with a dash', { path: 'my-cam' }],
+  ])('400 "Invalid path" for %s', async (_label, body) => {
+    asStreamer()
+    openAccessRequest(guestRequest())
+
+    const res = await approveAll(body)
+
+    expect(res.status).toBe(400)
+    expect(await res.json()).toEqual({ error: 'Invalid path' })
+    expect(listPendingRequests()).toHaveLength(1)
+  })
+
+  it('approves everyone waiting on that path and returns the count', async () => {
+    asStreamer()
+    openAccessRequest(guestRequest(GUEST_IP))
+    openAccessRequest(guestRequest(OTHER_IP))
+
+    const res = await approveAll({ path: 'cam' })
+
+    expect(res.status).toBe(200)
+    expect(await res.json()).toEqual({ approved: 2 })
+    expect(isApproved('cam', GUEST_IP, 'viewer')).toBe(true)
+    expect(isApproved('cam', OTHER_IP, 'viewer')).toBe(true)
+    expect(listPendingRequests()).toEqual([])
+  })
+
+  it('approves Discord viewers by account too', async () => {
+    asStreamer()
+    openAccessRequest(guestRequest())
+    openAccessRequest(discordRequest('42'))
+
+    const res = await approveAll({ path: 'cam' })
+
+    expect(await res.json()).toEqual({ approved: 2 })
+    expect(isApproved('cam', 'discord:42', 'discord')).toBe(true)
+    expect(isApproved('cam', GUEST_IP, 'viewer')).toBe(true)
+  })
+
+  it('leaves requests on other paths alone', async () => {
+    asStreamer()
+    openAccessRequest(guestRequest(GUEST_IP, 'cam'))
+    openAccessRequest(guestRequest(GUEST_IP, 'other'))
+
+    await approveAll({ path: 'cam' })
+
+    expect(isApproved('other', GUEST_IP, 'viewer')).toBe(false)
+    expect(listPendingRequests().map((r) => r.path)).toEqual(['other'])
+  })
+
+  it('approves nobody when no one is waiting', async () => {
+    asStreamer()
+
+    const res = await approveAll({ path: 'cam' })
+
+    expect(res.status).toBe(200)
+    expect(await res.json()).toEqual({ approved: 0 })
+  })
+})
