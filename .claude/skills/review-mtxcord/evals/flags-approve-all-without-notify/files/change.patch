+// Lets in everyone currently waiting on `path`; returns how many were approved.
+export function approveAllPending(path: string): number {
+  const waiting = listAccessRequests(Date.now() - STALE_MS).filter(
+    (r) => r.path === path,
+  )
+  for (const r of waiting) {
+    approveViewer(path, r.ip, r.role)
+    deleteAccessRequest(path, r.ip, r.role)
+  }
+  return waiting.length
+}
